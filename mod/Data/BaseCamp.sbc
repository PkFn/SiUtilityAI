<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Definition xsi:type="MyObjectBuilder_ItemTypeConstraint">
    <Id Type="ItemTypeConstraint" Subtype="SiBaseCampRecruits" />
    <Whitelist>true</Whitelist>
    <Item Type="InventoryItem" Subtype="DefenderRecruit" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_InventoryComponentDefinition">
    <Id Type="MyObjectBuilder_Inventory" Subtype="SiBaseCampRecruits" />
    <DisplayName>Recruit inventory</DisplayName>
    <MaxItemCount>40</MaxItemCount>
    <MultiplierEnabled>false</MultiplierEnabled>
    <Constraint Type="ItemTypeConstraint" Subtype="SiBaseCampRecruits" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_InventoryComponentDefinition">
    <Id Type="MyObjectBuilder_Inventory" Subtype="SiBaseCampWebbings" />
    <DisplayName>Webbing inventory</DisplayName>
    <MaxItemCount>200</MaxItemCount>
    <MultiplierEnabled>false</MultiplierEnabled>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiBaseCampComponentDefinition">
    <Id Type="MyObjectBuilder_SiBaseCampComponent" Subtype="SiBaseCamp" />
    <NearbySquadRadius>100</NearbySquadRadius>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_BuildableBlockDefinition">
    <Id Type="Block" Subtype="SiBaseCamp" />
    <DisplayName>Si Utility AI Base Camp</DisplayName>
    <Icon>Textures\GUI\Icons\TrainingStation.png</Icon>
    <GridDataDefinitionId Type="GridDataComponent" Subtype="LargeGridDataBase" />
    <Positions>
      <Position x="0" y="0" z="0" />
    </Positions>
    <Model>Models\TrainingStation.mwm</Model>
    <PhysicalMaterial>Wood</PhysicalMaterial>
    <Components>
      <Component Tag="Timber" Count="2" />
      <Component Tag="Plank" Count="12" />
      <Component Type="Block" Subtype="ChestWood" Count="1" />
      <Component Type="Block" Subtype="TableWoodSmall" Count="1" />
      <Component Tag="Plank" Count="3" />
    </Components>
    <MaxIntegrity>500</MaxIntegrity>
    <MountPoints>
      <MountPoint Side="Front" StartX="1.0324" StartY="-0.03239999" EndX="-0.032400012" EndY="1.0324" />
      <MountPoint Side="Back" StartX="-0.03239999" StartY="-0.03239999" EndX="1.0324" EndY="1.0324" />
      <MountPoint Side="Left" StartX="-0.03239999" StartY="-0.03239999" EndX="1.0324" EndY="1.0324" />
      <MountPoint Side="Right" StartX="1.0324" StartY="-0.03239999" EndX="-0.032400012" EndY="1.0324" />
      <MountPoint Side="Bottom" StartX="-0.03239999" StartY="-0.03239999" EndX="1.0324" EndY="1.0324" />
    </MountPoints>
    <BuildProgressModels>
      <Model BuildPercentUpperBound="0.9" File="Models\TrainingStationConstruction.mwm" />
    </BuildProgressModels>
    <Rotation>YAxis</Rotation>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ContainerDefinition" Copy="Append">
    <Id Type="Block" Subtype="SiBaseCamp" />
    <CopyFrom Type="EntityBase" Subtype="BaseFatBlock" />
    <Component Type="UseObjectsComponent" Subtype="SiBaseCamp" />
    <Component Type="Inventory" Subtype="SiBaseCampWebbings" />
    <Component Type="Inventory" Subtype="SiBaseCampRecruits" />
    <Component Type="SiBaseCampComponent" Subtype="SiBaseCamp" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_UseObjectsComponentDefinition">
    <Id Type="MyObjectBuilder_UseObjectsComponent" Subtype="SiBaseCamp" />
    <LoadFromModel>false</LoadFromModel>
    <UseObjects>
      <UseObject Dummy="detector_inventory" Name="Generic" />
    </UseObjects>
  </Definition>
</Definitions>
