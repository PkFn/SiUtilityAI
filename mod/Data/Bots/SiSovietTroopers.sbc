			<Helmet>PAX_Helmet_Soviet_Green_Star</Helmet>
		</Helmets>
		<UniformMatch>
			<Uniform>Uniform_Soviet_Khaki_upper_cm</Uniform>
		</UniformMatch>
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcArchetypeComponentDefinition">
