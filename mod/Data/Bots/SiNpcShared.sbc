    <Component Type="SiTakePlainViewBehavior" Subtype="SiTrooperTakePlainView" />
    <Component Type="SiSelfUnstuckTeleportBehavior" Subtype="SiTrooperSelfUnstuckTeleport" />
  </Definition>

