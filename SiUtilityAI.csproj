<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
    <ImplicitlyExpandDesignTimeFacades>false</ImplicitlyExpandDesignTimeFacades>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameBinPath>F:\SteamLibrary\steamapps\common\MedievalEngineers\Bin64</GameBinPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="mod\Data\Scripts\**\*.cs" />
    <Compile Include="ref_si_core\Data\Scripts\**\*.cs" />
    <Compile Include="ref_equi_core\Data\Scripts\**\*.cs" />
    <Compile Include="stubs\CompileOnly\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameBinPath)\Microsoft*.dll" Private="false" SpecificVersion="false" />
    <Reference Include="$(GameBinPath)\netstandard.dll" Private="false" SpecificVersion="false" />
    <Reference Include="$(GameBinPath)\System*.dll" Private="false" SpecificVersion="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MedievalEngineers.Game">
      <HintPath>$(GameBinPath)\MedievalEngineers.Game.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="MedievalEngineers.ObjectBuilders">
      <HintPath>$(GameBinPath)\MedievalEngineers.ObjectBuilders.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="MedievalEngineers.ObjectBuilders.XmlSerializers">
      <HintPath>$(GameBinPath)\MedievalEngineers.ObjectBuilders.XmlSerializers.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Sandbox.Game">
      <HintPath>$(GameBinPath)\Sandbox.Game.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Sandbox.Graphics">
      <HintPath>$(GameBinPath)\Sandbox.Graphics.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage">
      <HintPath>$(GameBinPath)\VRage.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Audio">
      <HintPath>$(GameBinPath)\VRage.Audio.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Game">
      <HintPath>$(GameBinPath)\VRage.Game.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Game.XmlSerializers">
      <HintPath>$(GameBinPath)\VRage.Game.XmlSerializers.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Input">
      <HintPath>$(GameBinPath)\VRage.Input.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Library">
      <HintPath>$(GameBinPath)\VRage.Library.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Math">
      <HintPath>$(GameBinPath)\VRage.Math.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Native">
      <HintPath>$(GameBinPath)\VRage.Native.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.OpenVRWrapper">
      <HintPath>$(GameBinPath)\VRage.OpenVRWrapper.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Render">
      <HintPath>$(GameBinPath)\VRage.Render.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Render11">
      <HintPath>$(GameBinPath)\VRage.Render11.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Scripting">
      <HintPath>$(GameBinPath)\VRage.Scripting.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.Steam">
