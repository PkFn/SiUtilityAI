<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

<Definition xsi:type="MyObjectBuilder_ContainerDefinition" Copy="Append">
    <Id Type="EntityBase" Subtype="SiTrooper_Soviet_Rifle" />
    <CopyFrom Type="EntityBase" Subtype="SiRifleTrooperBase" />
    <Component Type="SiNpcArchetypeComponent" Subtype="SiTrooper_Soviet_Rifle" />
    <Component Type="SiNpcLoadoutComponent" Subtype="Webbing_Soviet_Rifle" />
    <Component Type="SiNpcUniformComponent" Subtype="SiTrooper_Soviet_Rifle_Uniform" />
    <Component Type="SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Mosin" />
    <Component Type="SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Mosin" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ContainerDefinition" Copy="Append">
    <Id Type="EntityBase" Subtype="SiTrooper_Soviet_Rifle_Paratrooper" />
    <CopyFrom Type="EntityBase" Subtype="SiRifleTrooperBase" />
    <Component Type="SiNpcArchetypeComponent" Subtype="SiTrooper_Soviet_Rifle_Paratrooper" />
    <Component Type="SiNpcLoadoutComponent" Subtype="Webbing_Soviet_Rifle" />
    <Component Type="SiNpcUniformComponent" Subtype="SiTrooper_Soviet_Rifle_Paratrooper_Uniform" />
    <Component Type="SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Mosin" />
    <Component Type="SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Mosin" />
  </Definition>

	<Definition xsi:type="MyObjectBuilder_ContainerDefinition" Copy="Append">
		<Id Type="EntityBase" Subtype="SiTrooper_Soviet_Smg" />
		<CopyFrom Type="EntityBase" Subtype="SiRifleTrooperBase" />
