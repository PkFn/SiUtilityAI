<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Definition xsi:type="MyObjectBuilder_ContainerDefinition" Abstract="true" Copy="Append">
    <Id Type="EntityBase" Subtype="SiRifleTrooperBase" />
    <CopyFrom Type="EntityBase" Subtype="Humanoid" />
    <Tag>AI</Tag>
    <Component Type="CharacterPhysics" Subtype="Humanoid" />
    <Component Type="EntityTerrainHeightProvider" />
    <Component Type="SiGroundedNpcControllerComponent" Subtype="SiSoldierGroundedNpc" />
    <Component Type="MyObjectBuilder_PAX_CharacterUniformEquipment" />
    <Component Type="MyObjectBuilder_EquiEntityControllerComponent" />
    <Component Type="EntityOwnershipComponent" />
    <Component Type="EntityStateComponent" Subtype="CharacterStances" />
    <Component Type="Inventory" Subtype="Internal" />
    <Component Type="SiNpcInventoryShareComponent" />
    <Component Type="RagdollComponent" Subtype="Humanoid" />
    <Component Type="CharacterMovementComponent" Subtype="SiTrooperMovement" />
    <Component Type="ModelComponent" Subtype="Medieval_male_noApron" />
    <Component Type="SkeletonComponent" Subtype="Medieval_male" />
    <Component Type="AnimationCollisionComponent" Subtype="Medieval_male" />
    <Component Type="CharacterAnimationControllerComponent" Subtype="Medieval_male" />
    <Component Type="CharacterSoundComponent" Subtype="MedievalMale" />
    <Component Type="RenderComponentCharacter" Subtype="Medieval_male" />
    <Component Type="ThirdPersonCameraComponent" Subtype="DefaultThirdPerson" />
    <Component Type="ThirdPersonControllerComponent" Subtype="DefaultThirdPerson" />
    <Component Type="EntityStatComponent" Subtype="SiNpcStats" />
    <Component Type="CharacterDamageComponent" Subtype="Humanoid" />
    <Component Type="SiNpcCharacterDamageBridgeComponent" />
    <Component Type="DeathComponent" Subtype="Medieval_male_noApron" />
    <Component Type="EntityFXComponent" Subtype="Medieval_male" />
    <Component Type="SiNpcCombatStateComponent" />
    <Component Type="SiUtilityBrainComponent" Subtype="SiDefaultUtilityBrain" />
    <Component Type="SiRearmBehavior" Subtype="SiTrooperRearm" />
    <Component Type="SiUseTransportSeatsBehavior" Subtype="SiTrooperUseTransportSeats" />
    <Component Type="SiAdvanceTowardEnemyLeaderBehavior" Subtype="SiAiLeaderAdvanceToEnemyLeader" />
    <Component Type="SiTakeCoverBehavior" Subtype="SiTrooperTakeCover" />
    <Component Type="SiTakePlainViewBehavior" Subtype="SiTrooperTakePlainView" />
    <Component Type="SiSelfUnstuckTeleportBehavior" Subtype="SiTrooperSelfUnstuckTeleport" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ContainerDefinition" Copy="Append">
    <Id Type="EntityBase" Subtype="SiTrooper" />
    <CopyFrom Type="EntityBase" Subtype="SiRifleTrooperBase" />
    <Component Type="SiNpcArchetypeComponent" Subtype="SiTrooper_Generic" />
    <Component Type="SiNpcLoadoutComponent" Subtype="SiTrooper_UnconfiguredLoadout" />
    <Component Type="SiNpcWeaponSetComponent" />
    <Component Type="SiNpcUniformComponent" Subtype="SiTrooper_UnconfiguredUniform" />
    <Component Type="SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Generic" />
    <Component Type="SiThrowGrenadeBehavior" Subtype="SiTrooperThrowGrenade" />
    <Component Type="SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Generic" />
    <Component Type="SiNpcMeleeWeaponComponent" Subtype="SiTrooperMelee_Unconfigured" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcArchetypeComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcArchetypeComponent" Subtype="SiTrooper_Generic" />
    <Archetype>trooper</Archetype>
    <HiddenFromCommands>true</HiddenFromCommands>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcLoadoutComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcLoadoutComponent" Subtype="SiTrooper_UnconfiguredLoadout" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcUniformComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcUniformComponent" Subtype="SiTrooper_UnconfiguredUniform" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcMeleeWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcMeleeWeaponComponent" Subtype="SiTrooperMelee_Unconfigured" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_EntityStatComponentDefinition">
    <Id Type="MyObjectBuilder_EntityStatComponent" Subtype="SiNpcStats" />
    <Stat Type="MyObjectBuilder_EntityStatDefinition" Subtype="Health" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_CharacterMovementComponentDefinition">
    <Id Type="CharacterMovementComponent" Subtype="SiTrooperMovement" />
    <SprintSpeed Forward="7" Backward="0" Strafing="0" />
    <RunSpeed Forward="4.5" Backward="3.55" Strafing="3.25" />
    <WalkSpeed Forward="1.8" Backward="1.6" Strafing="1.45" />
    <CrouchSpeed Forward="1.3" Backward="0.9" Strafing="0.9" />
    <MaxSlope>70</MaxSlope>
    <JumpForce>2.5</JumpForce>
    <JumpForceForward>0.4</JumpForceForward>
  </Definition>

  <!-- Shared squad and formation tuning for every Si Utility AI bot. -->
  <Definition xsi:type="MyObjectBuilder_SiSquadSystemDefinition">
    <Id Type="MyObjectBuilder_SiSquadSystemDefinition" Subtype="SiDefaultSquadSystem" />
    <PlayerRank>corporal</PlayerRank>
    <NpcRank>private</NpcRank>
    <FollowDistance>2.5</FollowDistance>
    <ColumnSpacing>2.75</ColumnSpacing>
    <FileSpacing>1.5</FileSpacing>
    <LineSpacing>2.25</LineSpacing>
    <VeeSpacing>2.25</VeeSpacing>
    <FormationBoxSpacing>2.25</FormationBoxSpacing>
    <LongBoxAspectRatio>2.5</LongBoxAspectRatio>
    <WideBoxAspectRatio>0.4</WideBoxAspectRatio>
    <SquareBoxAspectRatio>1</SquareBoxAspectRatio>
    <StaggeredColumnOffset>0.75</StaggeredColumnOffset>
    <WaypointRefreshDistance>0.75</WaypointRefreshDistance>
    <EnemyJoinRadius>18</EnemyJoinRadius>

    <Ranks>
      <Rank Id="private" DisplayName="Private" Abbreviation="Pvt" Order="10" />
      <Rank Id="corporal" DisplayName="Corporal" Abbreviation="Cpl" Order="20" />
    </Ranks>

    <Letters>
      <Letter Code="A" Phonetic="Alpha" DisplayName="Alpha" />
      <Letter Code="B" Phonetic="Bravo" DisplayName="Bravo" />
      <Letter Code="C" Phonetic="Charlie" DisplayName="Charlie" />
      <Letter Code="D" Phonetic="Delta" DisplayName="Delta" />
      <Letter Code="E" Phonetic="Echo" DisplayName="Echo" />
      <Letter Code="F" Phonetic="Foxtrot" DisplayName="Foxtrot" />
      <Letter Code="G" Phonetic="Golf" DisplayName="Golf" />
      <Letter Code="H" Phonetic="Hotel" DisplayName="Hotel" />
      <Letter Code="I" Phonetic="India" DisplayName="India" />
      <Letter Code="J" Phonetic="Juliett" DisplayName="Juliett" />
      <Letter Code="K" Phonetic="Kilo" DisplayName="Kilo" />
      <Letter Code="L" Phonetic="Lima" DisplayName="Lima" />
      <Letter Code="M" Phonetic="Mike" DisplayName="Mike" />
      <Letter Code="N" Phonetic="November" DisplayName="November" />
      <Letter Code="O" Phonetic="Oscar" DisplayName="Oscar" />
      <Letter Code="P" Phonetic="Papa" DisplayName="Papa" />
      <Letter Code="Q" Phonetic="Quebec" DisplayName="Quebec" />
      <Letter Code="R" Phonetic="Romeo" DisplayName="Romeo" />
      <Letter Code="S" Phonetic="Sierra" DisplayName="Sierra" />
      <Letter Code="T" Phonetic="Tango" DisplayName="Tango" />
      <Letter Code="U" Phonetic="Uniform" DisplayName="Uniform" />
      <Letter Code="V" Phonetic="Victor" DisplayName="Victor" />
      <Letter Code="W" Phonetic="Whiskey" DisplayName="Whiskey" />
      <Letter Code="X" Phonetic="X-ray" DisplayName="X-ray" />
      <Letter Code="Y" Phonetic="Yankee" DisplayName="Yankee" />
      <Letter Code="Z" Phonetic="Zulu" DisplayName="Zulu" />
    </Letters>
  </Definition>
</Definitions>
