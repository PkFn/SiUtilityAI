<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- The brain is policy-neutral; attach behavior components beside it. -->
  <Definition xsi:type="MyObjectBuilder_SiUtilityBrainComponentDefinition">
    <Id Type="MyObjectBuilder_SiUtilityBrainComponent" Subtype="SiDefaultUtilityBrain" />
    <DecisionIntervalMilliseconds>250</DecisionIntervalMilliseconds>
    <StartupDelayMilliseconds>5000</StartupDelayMilliseconds>
    <SwitchScoreMargin>0.05</SwitchScoreMargin>
  </Definition>

  <!-- This definition is deliberately independent of the soldier entity. -->
  <Definition xsi:type="MyObjectBuilder_SiFollowNearbyPlayerBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiFollowNearbyPlayerBehavior" Subtype="SiSoldierFollowNearbyPlayer" />
    <SearchRadius>40</SearchRadius>
    <StopDistance>2</StopDistance>
    <ResumeDistance>3</ResumeDistance>
    <WaypointRefreshDistance>0.75</WaypointRefreshDistance>
    <BaseScore>0.2</BaseScore>
    <DistanceScore>0.8</DistanceScore>
    <DistanceExponent>1.5</DistanceExponent>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiUseTransportSeatsBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiUseTransportSeatsBehavior" Subtype="SiTrooperUseTransportSeats" />
    <InstantMountDistance>5.25</InstantMountDistance>
    <WaypointRefreshDistance>0.75</WaypointRefreshDistance>
    <ExitArrivalDistance>1.25</ExitArrivalDistance>
    <ActionIntervalMilliseconds>500</ActionIntervalMilliseconds>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiTakeCoverBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiTakeCoverBehavior" Subtype="SiTrooperTakeCover" />
    <SearchRadius>50</SearchRadius>
    <ThreatFrontExclusionAngleDegrees>90</ThreatFrontExclusionAngleDegrees>
    <CoverRescanLeaderDistance>6</CoverRescanLeaderDistance>
    <WaypointRefreshDistance>0.5</WaypointRefreshDistance>
    <CoverOccupancyRadius>1.4</CoverOccupancyRadius>
    <CoverArrivalDistance>1.2</CoverArrivalDistance>
    <MinimumCoverOffset>0.25</MinimumCoverOffset>
    <PreferredTreeOffset>0.55</PreferredTreeOffset>
    <MaximumCoverOffset>1.35</MaximumCoverOffset>
    <CoverOffsetStep>0.1</CoverOffsetStep>
    <BodyCoverAimHeight>0.95</BodyCoverAimHeight>
    <BodyCoverForwardOffset>0.15</BodyCoverForwardOffset>
    <SwitchDistanceFromLeader>8</SwitchDistanceFromLeader>
    <FullSwitchDistanceFromLeader>50</FullSwitchDistanceFromLeader>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiTakePlainViewBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiTakePlainViewBehavior" Subtype="SiTrooperTakePlainView" />
    <MinimumDistanceFromLeader>4</MinimumDistanceFromLeader>
    <MaximumDistanceFromLeader>10</MaximumDistanceFromLeader>
    <MinimumCachedPositionDistance>2</MinimumCachedPositionDistance>
    <ThreatFrontExclusionAngleDegrees>90</ThreatFrontExclusionAngleDegrees>
    <ArrivalDistance>1.25</ArrivalDistance>
    <WaypointRefreshDistance>0.75</WaypointRefreshDistance>
    <RepositionLeaderDistance>18</RepositionLeaderDistance>
    <BaseScore>0.35</BaseScore>
    <DistanceScore>0.65</DistanceScore>
    <DistanceExponent>1.2</DistanceExponent>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiSelfUnstuckTeleportBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiSelfUnstuckTeleportBehavior" Subtype="SiTrooperSelfUnstuckTeleport" />
    <ActivationScore>1</ActivationScore>
    <StuckTimeoutMilliseconds>2500</StuckTimeoutMilliseconds>
    <MaximumPlanarSpeed>0.5</MaximumPlanarSpeed>
    <MinimumRemainingDistance>1.5</MinimumRemainingDistance>
    <MinimumTeleportDistance>2.5</MinimumTeleportDistance>
    <MaximumTeleportDistance>7</MaximumTeleportDistance>
    <VerticalProbeHeight>4</VerticalProbeHeight>
    <VerticalProbeDepth>10</VerticalProbeDepth>
    <TeleportClearance>0.35</TeleportClearance>
    <MinimumGroundUpDot>0.6</MinimumGroundUpDot>
    <RetryCooldownMilliseconds>250</RetryCooldownMilliseconds>
  </Definition>

  <!-- Shared decision policy for all rifle troopers so no faction/model has hidden gameplay advantage. -->
  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
    <SearchRadius>200</SearchRadius>
    <BaseScore>0.45</BaseScore>
    <MaxScore>0.5</MaxScore>
    <DistanceScore>0.15</DistanceScore>
    <DistanceExponent>1</DistanceExponent>

    <RequireLineOfSight>true</RequireLineOfSight>
    <RotateToTarget>true</RotateToTarget>
    <EngageSpeech>engaging</EngageSpeech>
    <EngageSpeechCooldownMilliseconds>7000</EngageSpeechCooldownMilliseconds>
    <SpotTargetName>enemy infantry</SpotTargetName>
    <SpotSpeechCooldownMilliseconds>15000</SpotSpeechCooldownMilliseconds>
    <DetectionAccuracyWorseningMultiplier>2</DetectionAccuracyWorseningMultiplier>
    <TargetReevaluationIntervalMilliseconds>400</TargetReevaluationIntervalMilliseconds>
  </Definition>

  <!-- Uses PAX defender projectile definitions through the PAX projectile spawner. -->
  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Garand" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_K98" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Mosin" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiSmgTrooperSharedBalance" />
    <SearchRadius>140</SearchRadius>
    <BaseScore>0.8</BaseScore>
    <DistanceScore>0.2</DistanceScore>
    <DistanceExponent>1</DistanceExponent>
    <RequireLineOfSight>true</RequireLineOfSight>
    <RotateToTarget>true</RotateToTarget>
    <EngageSpeech>engaging</EngageSpeech>
    <EngageSpeechCooldownMilliseconds>7000</EngageSpeechCooldownMilliseconds>
    <SpotTargetName>enemy infantry</SpotTargetName>
    <SpotSpeechCooldownMilliseconds>15000</SpotSpeechCooldownMilliseconds>
    <DetectionAccuracyWorseningMultiplier>2</DetectionAccuracyWorseningMultiplier>
    <TargetReevaluationIntervalMilliseconds>400</TargetReevaluationIntervalMilliseconds>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Mp40" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiSmgTrooperSharedBalance" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Thompson" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiSmgTrooperSharedBalance" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Ppsh" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiSmgTrooperSharedBalance" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Generic" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiThrowGrenadeBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiThrowGrenadeBehavior" Subtype="SiTrooperThrowGrenade" />
    <MinimumDistance>8</MinimumDistance>
    <MaximumDistance>32</MaximumDistance>
    <BaseScore>0.5</BaseScore>
    <DistanceScore>0.85</DistanceScore>
    <DistanceExponent>2.4</DistanceExponent>
    <RequireLineOfSight>true</RequireLineOfSight>
    <RotateToTarget>true</RotateToTarget>
    <EquipDelayMilliseconds>700</EquipDelayMilliseconds>
    <RecoveryMilliseconds>1600</RecoveryMilliseconds>
    <ThrowCooldownMilliseconds>7000</ThrowCooldownMilliseconds>
  </Definition>

  <!-- Shared firing profile for the rifle family. -->
  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiRifleTrooperSharedWeaponBalance" />
    <FireCooldownMilliseconds>3100</FireCooldownMilliseconds>
    <BurstCount>1</BurstCount>
    <BurstCooldownMilliseconds>3100</BurstCooldownMilliseconds>
    <Projectile>Cartridge30Cal</Projectile>
    <ProjectileVelocityMultiplier>1</ProjectileVelocityMultiplier>
    <ProjectileAccuracyMultiplier>4</ProjectileAccuracyMultiplier>
    <ProjectileSyncDistance>1200</ProjectileSyncDistance>
    <CharacterDamageMultiplier>1</CharacterDamageMultiplier>
    <ShootingSpreadDegrees>1.0</ShootingSpreadDegrees>
    <ShootEffect Type="EffectDefinition" Subtype="Rifle30CalFireEffect" />
    <ShootSoundSpeedMetersPerSecond>343</ShootSoundSpeedMetersPerSecond>
    <ShootSoundMaxDelayMilliseconds>6000</ShootSoundMaxDelayMilliseconds>
    <ShootSoundFalloffMilliseconds>2000</ShootSoundFalloffMilliseconds>
    <ShootSoundDirectMaximumDelayMilliseconds>20</ShootSoundDirectMaximumDelayMilliseconds>
    <ShootSoundFrontAngleThreshold>0.6</ShootSoundFrontAngleThreshold>
    <ShootSoundFrontAngleBlendRange>0.15</ShootSoundFrontAngleBlendRange>
    <ShootSoundDistanceBlendStartMilliseconds>100</ShootSoundDistanceBlendStartMilliseconds>
    <ShootSoundDistanceBlendRangeMilliseconds>200</ShootSoundDistanceBlendRangeMilliseconds>
    <AimTargetHeight>0.9</AimTargetHeight>
    <AimExtraHeight>0.7</AimExtraHeight>
    <AimCloseRangeDistance>25</AimCloseRangeDistance>
    <AimCloseRangeHeightOffset>-0.1</AimCloseRangeHeightOffset>
    <ExpectedProjectileVelocity>800</ExpectedProjectileVelocity>
    <ElevationAiming>96000</ElevationAiming>
    <MuzzleForwardOffset>0.75</MuzzleForwardOffset>
    <MuzzleUpOffset>0.65</MuzzleUpOffset>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Garand" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiRifleTrooperSharedWeaponBalance" />
    <HeldItem Type="HandItemWithVariable" Subtype="M1_Garand" />
    <WeaponBehavior Type="MyObjectBuilder_PAX_HandheldGunDefinition" Subtype="M1_GarandScript" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Gewehr43" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiRifleTrooperSharedWeaponBalance" />
    <HeldItem Type="HandItemWithVariable" Subtype="Gewehr43" />
    <WeaponBehavior Type="MyObjectBuilder_PAX_HandheldGunDefinition" Subtype="Gewehr43Script" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_M1Carbine" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiRifleTrooperSharedWeaponBalance" />
    <HeldItem Type="HandItemWithVariable" Subtype="M1_Carbine" />
    <WeaponBehavior Type="MyObjectBuilder_PAX_HandheldGunDefinition" Subtype="M1_CarbineScript" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_K98" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiRifleTrooperSharedWeaponBalance" />
    <HeldItem Type="HandItemWithVariable" Subtype="Kar98k" />
    <WeaponBehavior Type="MyObjectBuilder_PAX_HandheldGunDefinition" Subtype="Kar98kScript" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Mosin" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiRifleTrooperSharedWeaponBalance" />
    <HeldItem Type="HandItemWithVariable" Subtype="Mosin" />
    <WeaponBehavior Type="MyObjectBuilder_PAX_HandheldGunDefinition" Subtype="MosinScript" />
  </Definition>

  <!-- Shared SMG burst profile; magazine size differences are balanced through reload time. -->
  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiSmgTrooperSharedWeaponBalance" />
    <FireCooldownMilliseconds>120</FireCooldownMilliseconds>
    <BurstCount>5</BurstCount>
    <BurstCooldownMilliseconds>450</BurstCooldownMilliseconds>
    <Projectile>Cartridge9mm</Projectile>
    <ProjectileVelocityMultiplier>1</ProjectileVelocityMultiplier>
    <ProjectileAccuracyMultiplier>10</ProjectileAccuracyMultiplier>
    <ProjectileSyncDistance>900</ProjectileSyncDistance>
    <CharacterDamageMultiplier>1</CharacterDamageMultiplier>
    <ShootingSpreadDegrees>4</ShootingSpreadDegrees>
    <ShootEffect Type="EffectDefinition" Subtype="Smg9mmFireEffect" />
    <ShootSoundSpeedMetersPerSecond>343</ShootSoundSpeedMetersPerSecond>
    <ShootSoundMaxDelayMilliseconds>6000</ShootSoundMaxDelayMilliseconds>
    <ShootSoundFalloffMilliseconds>2000</ShootSoundFalloffMilliseconds>
    <ShootSoundDirectMaximumDelayMilliseconds>20</ShootSoundDirectMaximumDelayMilliseconds>
    <ShootSoundFrontAngleThreshold>0.6</ShootSoundFrontAngleThreshold>
    <ShootSoundFrontAngleBlendRange>0.15</ShootSoundFrontAngleBlendRange>
    <ShootSoundDistanceBlendStartMilliseconds>100</ShootSoundDistanceBlendStartMilliseconds>
    <ShootSoundDistanceBlendRangeMilliseconds>200</ShootSoundDistanceBlendRangeMilliseconds>
    <AimTargetHeight>0.9</AimTargetHeight>
    <AimExtraHeight>0.55</AimExtraHeight>
    <AimCloseRangeDistance>20</AimCloseRangeDistance>
    <AimCloseRangeHeightOffset>-0.1</AimCloseRangeHeightOffset>
    <ExpectedProjectileVelocity>400</ExpectedProjectileVelocity>
    <ElevationAiming>96000</ElevationAiming>
    <MuzzleForwardOffset>0.72</MuzzleForwardOffset>
    <MuzzleUpOffset>0.65</MuzzleUpOffset>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Mp40" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiSmgTrooperSharedWeaponBalance" />
    <HeldItem Type="HandItemWithVariable" Subtype="MP-40" />
    <WeaponBehavior Type="MyObjectBuilder_PAX_HandheldGunDefinition" Subtype="MP-40Script" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Thompson" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiSmgTrooperSharedWeaponBalance" />
    <HeldItem Type="HandItemWithVariable" Subtype="Thompson_M1A1" />
    <WeaponBehavior Type="MyObjectBuilder_PAX_HandheldGunDefinition" Subtype="Thompson_M1A1Script" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Ppsh" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiSmgTrooperSharedWeaponBalance" />
    <HeldItem Type="HandItemWithVariable" Subtype="PPSh-41" />
    <WeaponBehavior Type="MyObjectBuilder_PAX_HandheldGunDefinition" Subtype="PPSh-41Script" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcRangedWeaponComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Generic" />
    <Balance Type="MyObjectBuilder_SiNpcRangedWeaponBalanceDefinition" Subtype="SiRifleTrooperSharedWeaponBalance" />
  </Definition>
</Definitions>
