<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Definition xsi:type="MyObjectBuilder_SiSquadSystemDefinition">
    <Id Type="MyObjectBuilder_SiSquadSystemDefinition" Subtype="SiDefaultSquadSystem" />
    <PlayerRank>corporal</PlayerRank>
    <NpcRank>private</NpcRank>
    <FollowDistance>2.5</FollowDistance>
    <ColumnSpacing>2.75</ColumnSpacing>
    <FileSpacing>1.5</FileSpacing>
    <LineSpacing>2.25</LineSpacing>
    <VeeSpacing>2.25</VeeSpacing>
    <WaypointRefreshDistance>0.75</WaypointRefreshDistance>
    <MarkerHeight>2.2</MarkerHeight>
    <MarkerMaxDistance>75</MarkerMaxDistance>
    <MarkerTextScale>0.65</MarkerTextScale>
    <EnemyJoinRadius>18</EnemyJoinRadius>

    <Ranks>
      <Rank Id="private" DisplayName="Private" Abbreviation="Pvt" Order="10" />
      <Rank Id="corporal" DisplayName="Corporal" Abbreviation="Cpl" Order="20" />
    </Ranks>

    <Letters>
      <Letter Code="A" Phonetic="Alpha" DisplayName="A-Alpha" />
      <Letter Code="B" Phonetic="Bravo" DisplayName="B-Bravo" />
      <Letter Code="C" Phonetic="Charlie" DisplayName="C-Charlie" />
      <Letter Code="D" Phonetic="Delta" DisplayName="D-Delta" />
      <Letter Code="E" Phonetic="Echo" DisplayName="E-Echo" />
      <Letter Code="F" Phonetic="Foxtrot" DisplayName="F-Foxtrot" />
      <Letter Code="G" Phonetic="Golf" DisplayName="G-Golf" />
      <Letter Code="H" Phonetic="Hotel" DisplayName="H-Hotel" />
      <Letter Code="I" Phonetic="India" DisplayName="I-India" />
      <Letter Code="J" Phonetic="Juliett" DisplayName="J-Juliett" />
      <Letter Code="K" Phonetic="Kilo" DisplayName="K-Kilo" />
      <Letter Code="L" Phonetic="Lima" DisplayName="L-Lima" />
      <Letter Code="M" Phonetic="Mike" DisplayName="M-Mike" />
      <Letter Code="N" Phonetic="November" DisplayName="N-November" />
      <Letter Code="O" Phonetic="Oscar" DisplayName="O-Oscar" />
      <Letter Code="P" Phonetic="Papa" DisplayName="P-Papa" />
      <Letter Code="Q" Phonetic="Quebec" DisplayName="Q-Quebec" />
      <Letter Code="R" Phonetic="Romeo" DisplayName="R-Romeo" />
      <Letter Code="S" Phonetic="Sierra" DisplayName="S-Sierra" />
      <Letter Code="T" Phonetic="Tango" DisplayName="T-Tango" />
      <Letter Code="U" Phonetic="Uniform" DisplayName="U-Uniform" />
      <Letter Code="V" Phonetic="Victor" DisplayName="V-Victor" />
      <Letter Code="W" Phonetic="Whiskey" DisplayName="W-Whiskey" />
      <Letter Code="X" Phonetic="X-ray" DisplayName="X-X-ray" />
      <Letter Code="Y" Phonetic="Yankee" DisplayName="Y-Yankee" />
      <Letter Code="Z" Phonetic="Zulu" DisplayName="Z-Zulu" />
    </Letters>
  </Definition>
</Definitions>
