		<Component Type="SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Ppsh" />
		<Component Type="SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Ppsh" />
	</Definition>

	<Definition xsi:type="MyObjectBuilder_ContainerDefinition" Copy="Append">
		<Id Type="EntityBase" Subtype="SiTrooper_Soviet_Smg_Paratrooper" />
		<CopyFrom Type="EntityBase" Subtype="SiRifleTrooperBase" />
		<Component Type="SiNpcArchetypeComponent" Subtype="SiTrooper_Soviet_Smg_Paratrooper" />
		<Component Type="SiNpcLoadoutComponent" Subtype="Webbing_Soviet_Smg" />
		<Component Type="SiNpcUniformComponent" Subtype="SiTrooper_Soviet_Smg_Paratrooper_Uniform" />
