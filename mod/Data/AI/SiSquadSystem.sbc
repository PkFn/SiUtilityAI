<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Definition xsi:type="MyObjectBuilder_SiSquadSystemDefinition">
    <Id Type="MyObjectBuilder_SiSquadSystemDefinition" Subtype="SiDefaultSquadSystem" />
    <PlayerRank>corporal</PlayerRank>
    <NpcRank>private</NpcRank>
    <FollowDistance>2.5</FollowDistance>
    <ColumnSpacing>2.75</ColumnSpacing>
    <FileSpacing>1.5</FileSpacing>
    <LineSpacing>2.25</LineSpacing>
    <VeeSpacing>2.25</VeeSpacing>
    <WaypointRefreshDistance>0.75</WaypointRefreshDistance>
    <EnemyJoinRadius>18</EnemyJoinRadius>

    <Ranks>
      <Rank Id="private" DisplayName="Private" Abbreviation="Pvt" Order="10" />
      <Rank Id="corporal" DisplayName="Corporal" Abbreviation="Cpl" Order="20" />
    </Ranks>

    <Letters>
      <Letter Code="A" Phonetic="Alpha" DisplayName="Alpha" />
      <Letter Code="B" Phonetic="Bravo" DisplayName="Bravo" />
      <Letter Code="C" Phonetic="Charlie" DisplayName="Charlie" />
      <Letter Code="D" Phonetic="Delta" DisplayName="Delta" />
      <Letter Code="E" Phonetic="Echo" DisplayName="Echo" />
      <Letter Code="F" Phonetic="Foxtrot" DisplayName="Foxtrot" />
      <Letter Code="G" Phonetic="Golf" DisplayName="Golf" />
      <Letter Code="H" Phonetic="Hotel" DisplayName="Hotel" />
      <Letter Code="I" Phonetic="India" DisplayName="India" />
      <Letter Code="J" Phonetic="Juliett" DisplayName="Juliett" />
      <Letter Code="K" Phonetic="Kilo" DisplayName="Kilo" />
      <Letter Code="L" Phonetic="Lima" DisplayName="Lima" />
      <Letter Code="M" Phonetic="Mike" DisplayName="Mike" />
      <Letter Code="N" Phonetic="November" DisplayName="November" />
      <Letter Code="O" Phonetic="Oscar" DisplayName="Oscar" />
      <Letter Code="P" Phonetic="Papa" DisplayName="Papa" />
      <Letter Code="Q" Phonetic="Quebec" DisplayName="Quebec" />
      <Letter Code="R" Phonetic="Romeo" DisplayName="Romeo" />
      <Letter Code="S" Phonetic="Sierra" DisplayName="Sierra" />
      <Letter Code="T" Phonetic="Tango" DisplayName="Tango" />
      <Letter Code="U" Phonetic="Uniform" DisplayName="Uniform" />
      <Letter Code="V" Phonetic="Victor" DisplayName="Victor" />
      <Letter Code="W" Phonetic="Whiskey" DisplayName="Whiskey" />
      <Letter Code="X" Phonetic="X-ray" DisplayName="X-ray" />
      <Letter Code="Y" Phonetic="Yankee" DisplayName="Yankee" />
      <Letter Code="Z" Phonetic="Zulu" DisplayName="Zulu" />
    </Letters>
  </Definition>
</Definitions>
