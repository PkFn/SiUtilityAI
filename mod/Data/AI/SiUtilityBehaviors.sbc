<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- The brain is policy-neutral; attach behavior components beside it. -->
  <Definition xsi:type="MyObjectBuilder_SiUtilityBrainComponentDefinition">
    <Id Type="MyObjectBuilder_SiUtilityBrainComponent" Subtype="SiDefaultUtilityBrain" />
    <DecisionIntervalMilliseconds>250</DecisionIntervalMilliseconds>
    <StartupDelayMilliseconds>5000</StartupDelayMilliseconds>
    <SwitchScoreMargin>0.05</SwitchScoreMargin>
  </Definition>

  <!-- This definition is deliberately independent of the soldier entity. -->
  <Definition xsi:type="MyObjectBuilder_SiFollowNearbyPlayerBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiFollowNearbyPlayerBehavior" Subtype="SiSoldierFollowNearbyPlayer" />
    <SearchRadius>40</SearchRadius>
    <StopDistance>2</StopDistance>
    <ResumeDistance>3</ResumeDistance>
    <WaypointRefreshDistance>0.75</WaypointRefreshDistance>
    <BaseScore>0.2</BaseScore>
    <DistanceScore>0.8</DistanceScore>
    <DistanceExponent>1.5</DistanceExponent>
  </Definition>

  <!-- Shared by all rifle troopers so no faction/model has hidden gameplay advantage. -->
  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
    <SearchRadius>200</SearchRadius>
    <BaseScore>0.85</BaseScore>
    <DistanceScore>0.15</DistanceScore>
    <DistanceExponent>1</DistanceExponent>

    <FireCooldownMilliseconds>3100</FireCooldownMilliseconds>
    <Projectile>Cartridge30Cal</Projectile>
    <ProjectileVelocityMultiplier>1</ProjectileVelocityMultiplier>
    <ProjectileAccuracyMultiplier>4</ProjectileAccuracyMultiplier>
    <ProjectileSyncDistance>1200</ProjectileSyncDistance>
    <CharacterDamageMultiplier>1</CharacterDamageMultiplier>

    <ShootEffect Type="EffectDefinition" Subtype="Rifle30CalFireEffect" />
    <ShootSoundSpeedMetersPerSecond>343</ShootSoundSpeedMetersPerSecond>
    <ShootSoundMaxDelayMilliseconds>6000</ShootSoundMaxDelayMilliseconds>
    <ShootSoundFalloffMilliseconds>2000</ShootSoundFalloffMilliseconds>
    <ShootSoundDirectMaximumDelayMilliseconds>20</ShootSoundDirectMaximumDelayMilliseconds>
    <ShootSoundFrontAngleThreshold>0.6</ShootSoundFrontAngleThreshold>
    <ShootSoundFrontAngleBlendRange>0.15</ShootSoundFrontAngleBlendRange>
    <ShootSoundDistanceBlendStartMilliseconds>100</ShootSoundDistanceBlendStartMilliseconds>
    <ShootSoundDistanceBlendRangeMilliseconds>200</ShootSoundDistanceBlendRangeMilliseconds>

    <AimTargetHeight>0.9</AimTargetHeight>
    <AimExtraHeight>0.7</AimExtraHeight>
    <AimCloseRangeDistance>25</AimCloseRangeDistance>
    <AimCloseRangeHeightOffset>-0.1</AimCloseRangeHeightOffset>
    <ExpectedProjectileVelocity>800</ExpectedProjectileVelocity>
    <ElevationAiming>96000</ElevationAiming>
    <MuzzleForwardOffset>0.75</MuzzleForwardOffset>
    <MuzzleUpOffset>0.65</MuzzleUpOffset>

    <RequireLineOfSight>true</RequireLineOfSight>
    <RotateToTarget>true</RotateToTarget>
    <EngageSpeech>engaging</EngageSpeech>
    <EngageSpeechCooldownMilliseconds>7000</EngageSpeechCooldownMilliseconds>
    <SpotTargetName>enemy infantry</SpotTargetName>
    <SpotSpeechCooldownMilliseconds>15000</SpotSpeechCooldownMilliseconds>
    <TargetArchetypes>
      <Archetype>trooper</Archetype>
      <Archetype>german-rifle-trooper</Archetype>
      <Archetype>soviet-rifle-trooper</Archetype>
      <Archetype>enemy-trooper</Archetype>
    </TargetArchetypes>
  </Definition>

  <!-- Uses PAX defender projectile definitions through the PAX projectile spawner. -->
  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Garand" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
    <ShootSoundName>M1_Garand_Shot_Holder</ShootSoundName>
    <ShootSoundMid>M1_Garand_Shot_Mid</ShootSoundMid>
    <ShootSoundMidFront>M1_Garand_Shot_Mid_Front</ShootSoundMidFront>
    <ShootSoundFar>M1_Garand_Shot_Far</ShootSoundFar>
    <ShootSoundFarFront>M1_Garand_Shot_Far_Front</ShootSoundFarFront>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_K98" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
    <ShootSoundName>K98_Shot_Holder</ShootSoundName>
    <ShootSoundMid>K98_Shot_Mid</ShootSoundMid>
    <ShootSoundMidFront>K98_Shot_Mid_Front</ShootSoundMidFront>
    <ShootSoundFar>K98_Shot_Far</ShootSoundFar>
    <ShootSoundFarFront>K98_Shot_Far_Front</ShootSoundFarFront>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiShootOpposingNpcBehaviorDefinition">
    <Id Type="MyObjectBuilder_SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Mosin" />
    <Balance Type="MyObjectBuilder_SiShootOpposingNpcBehaviorBalanceDefinition" Subtype="SiRifleTrooperSharedBalance" />
    <ShootSoundName>Mosin_Shot_Holder</ShootSoundName>
    <ShootSoundMid>Mosin_Shot_Mid</ShootSoundMid>
    <ShootSoundMidFront>Mosin_Shot_Mid_Front</ShootSoundMidFront>
    <ShootSoundFar>Mosin_Shot_Far</ShootSoundFar>
    <ShootSoundFarFront>Mosin_Shot_Far_Front</ShootSoundFarFront>
  </Definition>
</Definitions>
