<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Definition xsi:type="MyObjectBuilder_SiSpottingSystemDefinition">
    <Id Type="MyObjectBuilder_SiSpottingSystemDefinition" Subtype="SiDefaultSpottingSystem" />
    <VehicleTargeting Type="MyObjectBuilder_SiVehicleTargetingSpotScoreDefinition" Subtype="SiDefaultVehicleTargetingSpotScore" />
    <Constant>1.0</Constant>
    <CombatThreatDirectionThresholdMultiplier>0.66</CombatThreatDirectionThresholdMultiplier>
    <CombatThreatDirectionAngleDegrees>45</CombatThreatDirectionAngleDegrees>
    <SpottingReevaluationIntervalMilliseconds>250</SpottingReevaluationIntervalMilliseconds>
    <SpottingTrackingTimeoutMilliseconds>2000</SpottingTrackingTimeoutMilliseconds>
    <HearingGuaranteedRadius>4</HearingGuaranteedRadius>
    <StillnessVelocityThreshold>0.4</StillnessVelocityThreshold>
    <StillnessChanceMultiplier>0.75</StillnessChanceMultiplier>
    <RecentShotMilliseconds>1800</RecentShotMilliseconds>
    <NotFiringChanceMultiplier>0.55</NotFiringChanceMultiplier>
    <ShotAwarenessPerShot>1.00</ShotAwarenessPerShot>
    <ShotAwarenessDecayPerSecond>0.01</ShotAwarenessDecayPerSecond>
    <ShotAwarenessMaxDistance>140</ShotAwarenessMaxDistance>
    <ShotAwarenessDistanceExponent>1.2</ShotAwarenessDistanceExponent>
    <NearbyBushScanRadius>3</NearbyBushScanRadius>
    <NearbyBushMinimumChanceMultiplier>0.45</NearbyBushMinimumChanceMultiplier>
    <NearbyBushDistanceExponent>1.5</NearbyBushDistanceExponent>
    <DarknessMinimumChanceMultiplier>0.35</DarknessMinimumChanceMultiplier>
    <DarknessNightSolarElevation>-0.2</DarknessNightSolarElevation>
    <DarknessDaySolarElevation>0.2</DarknessDaySolarElevation>
    <InteriorChanceMultiplier>0.35</InteriorChanceMultiplier>
    <VehicleSpottingBaseGain>1.5</VehicleSpottingBaseGain>
    <VehicleSpottingMovingSpeedThreshold>3</VehicleSpottingMovingSpeedThreshold>
    <VehicleSpottingMaxSpeed>18</VehicleSpottingMaxSpeed>
    <VehicleSpottingMovingGain>2</VehicleSpottingMovingGain>
  </Definition>

</Definitions>
