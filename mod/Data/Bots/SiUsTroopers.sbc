		</Helmets>
		<UniformMatch>
			<Uniform>Uniform_US_Tan_upper_cm</Uniform>
		</UniformMatch>
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcArchetypeComponentDefinition">
