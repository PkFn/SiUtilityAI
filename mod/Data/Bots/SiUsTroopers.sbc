		<Component Type="SiNpcUniformComponent" Subtype="SiTrooper_US_Smg_Uniform" />
		<Component Type="SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Thompson" />
		<Component Type="SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Thompson" />
	</Definition>

	<Definition xsi:type="MyObjectBuilder_ContainerDefinition" Copy="Append">
		<Id Type="EntityBase" Subtype="SiTrooper_US_Smg_Paratrooper" />
		<CopyFrom Type="EntityBase" Subtype="SiRifleTrooperBase" />
		<Component Type="SiNpcArchetypeComponent" Subtype="SiTrooper_US_Smg_Paratrooper" />
		<Component Type="SiNpcLoadoutComponent" Subtype="Webbing_US_Smg" />
		<Component Type="SiNpcUniformComponent" Subtype="SiTrooper_US_Smg_Paratrooper_Uniform" />
		<Component Type="SiShootOpposingNpcBehavior" Subtype="SiTrooperShootOpposingTrooper_Thompson" />
		<Component Type="SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Thompson" />
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcUniformComponentDefinition">
		<Id Type="MyObjectBuilder_SiNpcUniformComponent" Subtype="SiTrooper_US_Rifle_Uniform" />
		<Uniform Type="MyObjectBuilder_PAX_UniformEquipment" Subtype="PAX_UniformEquipmentScript_US_Olive" />
		<UniformMatch>
			<Uniform>Uniform_US_Olive_upper_cm</Uniform>
		</UniformMatch>
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcUniformComponentDefinition">
		<Id Type="MyObjectBuilder_SiNpcUniformComponent" Subtype="SiTrooper_US_Smg_Uniform" />
		<Uniform Type="MyObjectBuilder_PAX_UniformEquipment" Subtype="PAX_UniformEquipmentScript_US_Olive" />
		<UniformMatch>
			<Uniform>Uniform_US_Olive_upper_cm</Uniform>
		</UniformMatch>
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcUniformComponentDefinition">
		<Id Type="MyObjectBuilder_SiNpcUniformComponent" Subtype="SiTrooper_US_Rifle_Paratrooper_Uniform" />
		<Uniform Type="MyObjectBuilder_PAX_UniformEquipment" Subtype="PAX_UniformEquipmentScript_US_Tan" />
		<DefaultHelmet>PAX_Helmet_M1_Net</DefaultHelmet>
		<DefaultBackpack>PAX_ParachuteBackpack_CamoUS</DefaultBackpack>
		<Helmets>
			<Helmet>PAX_Helmet_M1_Net</Helmet>
		</Helmets>
		<UniformMatch>
			<Uniform>Uniform_US_Tan_upper_cm</Uniform>
		</UniformMatch>
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcUniformComponentDefinition">
		<Id Type="MyObjectBuilder_SiNpcUniformComponent" Subtype="SiTrooper_US_Smg_Paratrooper_Uniform" />
		<Uniform Type="MyObjectBuilder_PAX_UniformEquipment" Subtype="PAX_UniformEquipmentScript_US_Tan" />
		<DefaultHelmet>PAX_Helmet_M1_Net</DefaultHelmet>
		<DefaultBackpack>PAX_ParachuteBackpack_CamoUS</DefaultBackpack>
