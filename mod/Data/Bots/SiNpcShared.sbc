    <Component Type="SiTakePlainViewBehavior" Subtype="SiTrooperTakePlainView" />
    <Component Type="SiSelfUnstuckTeleportBehavior" Subtype="SiTrooperSelfUnstuckTeleport" />
  </Definition>

  <Definition xsi:type="MyObjectBuilder_SiNpcHeldWeaponVisualComponentDefinition">
    <Id Type="MyObjectBuilder_SiNpcHeldWeaponVisualComponent" Subtype="SiTrooperHeldWeapon_Garand" />
