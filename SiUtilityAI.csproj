      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="VRage.XmlSerializers">
      <HintPath>$(GameBinPath)\VRage.XmlSerializers.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <Target Name="CheckIngameScriptApi" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Check-IngameScriptApi.ps1&quot; -Roots &quot;$(MSBuildProjectDirectory)\mod\Data\Scripts;$(MSBuildProjectDirectory)\ref_si_core\Data\Scripts&quot;" />
  </Target>

</Project>
