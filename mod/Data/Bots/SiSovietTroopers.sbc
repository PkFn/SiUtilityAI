		<Component Type="SiNpcRangedWeaponComponent" Subtype="SiTrooperWeapon_Ppsh" />
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcUniformComponentDefinition">
		<Id Type="MyObjectBuilder_SiNpcUniformComponent" Subtype="SiTrooper_Soviet_Rifle_Uniform" />
		<Uniform Type="MyObjectBuilder_PAX_UniformEquipment" Subtype="PAX_UniformEquipmentScript_Soviet_Khaki" />
		<UniformMatch>
			<Uniform>Uniform_Soviet_Khaki_upper_cm</Uniform>
		</UniformMatch>
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcUniformComponentDefinition">
		<Id Type="MyObjectBuilder_SiNpcUniformComponent" Subtype="SiTrooper_Soviet_Smg_Uniform" />
		<Uniform Type="MyObjectBuilder_PAX_UniformEquipment" Subtype="PAX_UniformEquipmentScript_Soviet_Khaki" />
		<UniformMatch>
			<Uniform>Uniform_Soviet_Khaki_upper_cm</Uniform>
		</UniformMatch>
	</Definition>

	<Definition xsi:type="MyObjectBuilder_SiNpcUniformComponentDefinition">
		<Id Type="MyObjectBuilder_SiNpcUniformComponent" Subtype="SiTrooper_Soviet_Rifle_Paratrooper_Uniform" />
		<Uniform Type="MyObjectBuilder_PAX_UniformEquipment" Subtype="PAX_UniformEquipmentScript_Soviet_Brown" />
		<DefaultHelmet>PAX_Helmet_Soviet_Green_Star</DefaultHelmet>
		<DefaultBackpack>PAX_ParachuteBackpack_White</DefaultBackpack>
		<Helmets>
			<Helmet>PAX_Helmet_Soviet_Green_Star</Helmet>
		</Helmets>
		<UniformMatch>
			<Uniform>Uniform_Soviet_Khaki_upper_cm</Uniform>
		</UniformMatch>
	</Definition>

