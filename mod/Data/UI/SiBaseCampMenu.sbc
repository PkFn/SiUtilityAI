<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://storage.googleapis.com/unofficial-keen-schemas/latest/medieval-modded.xsd">
  <Definition xsi:type="MyObjectBuilder_GuiSkinDefinition" Merge="Append" Copy="Append">
    <Id Type="MyObjectBuilder_GuiSkinDefinition" Subtype="Default" />
    <Listbox StyleName="SiBaseCampListboxWide" Texture="ListboxBackground">
      <Item TextScale="1.0" TextOffset="16">
        <Size x="720" y="40" />
        <Offset x="0" y="0" />
        <Normal Font="VollkornRegularPlain" TextColor="#3C2000" />
        <Highlight Font="VollkornRegularPlain" TextColor="#3C2000" />
        <ActiveTexture>Textures\GUI\Controls\item_highlight_light.dds</ActiveTexture>
        <HighlightTexture>Textures\GUI\Controls\item_highlight_dark.dds</HighlightTexture>
      </Item>
      <VariableWidth>false</VariableWidth>
      <DrawScrollbar>true</DrawScrollbar>
    </Listbox>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ContextMenuDefinition">
    <Id Type="MyObjectBuilder_ContextMenu" Subtype="SiBaseCampMenu" />
    <StyleName>ContextMenuDefault</StyleName>
    <Position x="0.35" y="0.32" />
    <MainController Type="MyObjectBuilder_ButtonListController" Subtype="SiBaseCampMenuRoot" />
    <ContextType>MyObjectBuilder_SiBaseCampMenuContext</ContextType>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ButtonListControllerDefinition">
    <Id Type="MyObjectBuilder_ButtonListController" Subtype="SiBaseCampMenuRoot" />
    <Title>Si Utility AI Base Camp</Title>
    <Columns>3</Columns>
    <Rows>1</Rows>
    <ButtonStyleId>ButtonListWide</ButtonStyleId>
    <Buttons>
      <Button StyleName="ContextButtonSliced"><Text>Inventory</Text><Tooltip>Open the recruit and webbing storage inventories.</Tooltip><Action xsi:type="MyObjectBuilder_CMA_ContextMethod" Name="OpenInventory" /></Button>
      <Button StyleName="ContextButtonSliced"><Text>Spawn</Text><Tooltip>Prepare a squad from the webbings stored at this base camp.</Tooltip><Action xsi:type="MyObjectBuilder_CMA_AddController"><Controller Type="MyObjectBuilder_EquiAdvancedController" Subtype="SiBaseCampSpawn" /></Action></Button>
      <Button StyleName="ContextButtonSliced"><Text>Refund</Text><Tooltip>Choose a nearby allied squad to refund later.</Tooltip><Action xsi:type="MyObjectBuilder_CMA_AddController"><Controller Type="MyObjectBuilder_EquiAdvancedController" Subtype="SiBaseCampRefund" /></Action></Button>
    </Buttons>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_EquiAdvancedControllerDefinition">
    <Id Type="MyObjectBuilder_EquiAdvancedController" Subtype="SiBaseCampSpawn" />
    <Title>Spawn squad</Title><Width>800</Width><AutoCommit>true</AutoCommit>
    <Embedded><Id Type="MyObjectBuilder_ListboxController" Subtype="SiBaseCampWebbingList" /></Embedded>
    <Embedded><Id Type="MyObjectBuilder_ButtonListController" Subtype="SiBaseCampSpawnButtons" /></Embedded>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ListboxControllerDefinition">
    <Id Type="MyObjectBuilder_ListboxController" Subtype="SiBaseCampWebbingList" />
    <Title>Future squad members</Title><DataId>BaseCampWebbingInventory</DataId>
    <Listbox StyleName="SiBaseCampListboxWide" MinSize="4" MaxSize="12"><AutoCommit>true</AutoCommit></Listbox>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ButtonListControllerDefinition">
    <Id Type="MyObjectBuilder_ButtonListController" Subtype="SiBaseCampSpawnButtons" />
    <Columns>2</Columns><Rows>1</Rows><ButtonStyleId>ButtonListWide</ButtonStyleId>
    <Buttons>
      <Button StyleName="ContextButtonSliced"><Text>AI squad</Text><Tooltip>Spawn an AI-led squad whose leader controls its movement and orders.</Tooltip><Action xsi:type="MyObjectBuilder_CMA_ContextMethod" Name="BaseCampSpawnAiSquad" /></Button>
      <Button StyleName="ContextButtonSliced"><Text>Player squad</Text><Tooltip>Spawn a player-led squad that the player can command directly.</Tooltip><Action xsi:type="MyObjectBuilder_CMA_ContextMethod" Name="BaseCampSpawnPlayerSquad" /></Button>
    </Buttons>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_EquiAdvancedControllerDefinition">
    <Id Type="MyObjectBuilder_EquiAdvancedController" Subtype="SiBaseCampRefund" />
    <Title>Refund squad</Title><Width>800</Width><AutoCommit>true</AutoCommit>
    <Embedded><Id Type="MyObjectBuilder_ListboxController" Subtype="SiBaseCampNearbySquadsList" /></Embedded>
    <Label><Line>{BaseCampSelectedLeader}</Line></Label>
    <Embedded>
      <Id Type="MyObjectBuilder_ListboxController" Subtype="SiBaseCampMembersList" />
      <RebuildReference Id="BaseCampSelectedSquadVersion" />
    </Embedded>
    <Embedded><Id Type="MyObjectBuilder_ButtonListController" Subtype="SiBaseCampRefundButtons" /></Embedded>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ListboxControllerDefinition">
    <Id Type="MyObjectBuilder_ListboxController" Subtype="SiBaseCampNearbySquadsList" />
    <Title>Nearby allied squads</Title><DataId>BaseCampNearbySquads</DataId>
    <Listbox StyleName="SiBaseCampListboxWide" MinSize="3" MaxSize="8"><AutoCommit>true</AutoCommit></Listbox>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ListboxControllerDefinition">
    <Id Type="MyObjectBuilder_ListboxController" Subtype="SiBaseCampMembersList" />
    <Title>Squad members</Title><DataId>BaseCampSelectedMembers</DataId>
    <Listbox StyleName="SiBaseCampListboxWide" MinSize="3" MaxSize="8"><AutoCommit>true</AutoCommit></Listbox>
  </Definition>

  <Definition xsi:type="MyObjectBuilder_ButtonListControllerDefinition">
    <Id Type="MyObjectBuilder_ButtonListController" Subtype="SiBaseCampRefundButtons" />
    <Columns>1</Columns><Rows>1</Rows><ButtonStyleId>ButtonListWide</ButtonStyleId>
    <Buttons><Button StyleName="ContextButtonSliced"><Text>Refund</Text><Tooltip>Despawn the selected squad and drop each recruit and inventory in an item sack.</Tooltip><Action xsi:type="MyObjectBuilder_CMA_ContextMethod" Name="BaseCampRefundSquad" /></Button></Buttons>
  </Definition>
</Definitions>
