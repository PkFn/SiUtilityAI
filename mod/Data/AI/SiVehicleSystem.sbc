<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- Shared throttle tuning for AI-controlled vehicles. -->
  <Definition xsi:type="MyObjectBuilder_SiVehicleSystemDefinition">
    <Id Type="MyObjectBuilder_SiVehicleSystemDefinition" Subtype="SiDefaultVehicleSystem" />
    <!-- Fixed additional target speed while the horse is outside the formation hysteresis radius. -->
    <PaxHorseCatchUpThrottle>1.0</PaxHorseCatchUpThrottle>
    <!-- Distance around the formation target that adds no catch-up throttle. -->
    <PaxHorseThrottleHysteresisRadius>1</PaxHorseThrottleHysteresisRadius>
  </Definition>
</Definitions>
